<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form2_mm_timesheet" model="ir.ui.view">
        <field name="name">project.task.form.mm.timesheet</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="mm_timesheet" string="Horas">
                    <field name="mm_timesheet_time_ids"/>
                </page>
            </xpath>
        </field>
    </record>


</odoo>
