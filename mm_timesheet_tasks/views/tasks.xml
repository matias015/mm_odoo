<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form2_mm_timesheet" model="ir.ui.view">
        <field name="name">project.task.form.mm.timesheet</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="mm_timesheet" string="Horas">
                    <field name="mm_timesheet_time_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="time" widget="float_time"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <field name="user_ids" position="after">
                <field name="mm_estimated_time" widget="float_time"/>
                <field name="mm_real_time" widget="float_time"/>
            </field>
        </field>
    </record>


    <record id="view_task_kanban_mm_timesheet" model="ir.ui.view">
        <field name="name">project.task.kanban.mm.timesheet</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <field name="priority" position="after">
                <div class="px-2">
                    <field name="mm_estimated_time" widget="float_time" invisible="not mm_estimated_time"/> 
                </div>
            </field>
        </field>
    </record>


</odoo>
