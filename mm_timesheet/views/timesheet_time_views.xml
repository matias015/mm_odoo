<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_timesheet_time_list" model="ir.ui.view">
        <field name="name">timesheet.time.list</field>
        <field name="model">timesheet.time</field>
        <field name="arch" type="xml">
            <list string="Registros de horas" editable="bottom">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="time" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_timesheet_time_form" model="ir.ui.view">
        <field name="name">timesheet.time.form</field>
        <field name="model">timesheet.time</field>
        <field name="arch" type="xml">
            <form string="Registro de horas">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="time" widget="float_time"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="name" placeholder="Descripción..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_timesheet_time_search" model="ir.ui.view">
        <field name="name">timesheet.time.search</field>
        <field name="model">timesheet.time</field>
        <field name="arch" type="xml">
            <search string="Registros de horas">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <group>
                
                    <filter string="Empleado" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Fecha" name="group_by_date" context="{'group_by': 'date'}"/>
               
                </group> 
            </search>
        </field>
    </record>

    <record id="action_timesheet_time" model="ir.actions.act_window">
        <field name="name">Registros de horas</field>
        <field name="res_model">timesheet.time</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo registro de horas
            </p>
        </field>
    </record>

</odoo>
